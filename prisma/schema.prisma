generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  password       String
  role           userRole  @default(CUSTOMER)
  create_at      DateTime  @default(now())
  lastest_update DateTime?
  orders         Order[]
  restocks       Restock[]
}

model Drink {
  id             Int          @id @default(autoincrement())
  name           String
  price          Float
  mainIngredient String?
  img            String?
  ingredients    Ingredient[]
  orders         Order[]
}

model StockItem {
  id              Int          @id @default(autoincrement())
  name            String
  category        String
  unit            String
  maxQuantity     Int
  img             String?
  currentQuantity Int          @default(0)
  status          stockStatus  @default(OUT)
  lastUpdated     DateTime     @default(now())
  useIn           Ingredient[]
  restock         Restock[]
}

model Order {
  id          Int         @id @default(autoincrement())
  addon       Int?
  drinkType   drinkType   @default(COLD)
  sweetLevel  sweetness   @default(NORMAL_SUGAR)
  cupSize     cupSize     @default(MEDIUM)
  orderStatus statusOrder @default(PENDING)
  orderDate   DateTime    @default(now())
  amount      Int         @default(1)
  employeeId  String?
  drinkId     Int
  drink       Drink       @relation(fields: [drinkId], references: [id])
  employee    User?       @relation(fields: [employeeId], references: [id])
}

model Ingredient {
  id          Int       @id @default(autoincrement())
  quantity    Float
  stockItemId Int
  drinkId     Int
  drink       Drink     @relation(fields: [drinkId], references: [id], onDelete: Cascade)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
}

model Restock {
  id            String    @id @default(uuid())
  oldQuantity   Int
  newQuantity   Int
  totalQuantity Int
  employeeId    String
  restockDate   DateTime  @default(now())
  stockItemId   Int
  employee      User      @relation(fields: [employeeId], references: [id])
  stockItem     StockItem @relation(fields: [stockItemId], references: [id])
}

enum userRole {
  CUSTOMER
  EMPLOYEE
  MANAGER
}

enum statusOrder {
  PENDING
  COMPLETED
  CANCELLED
}

enum drinkType {
  HOT
  COLD
  MIXED
}

enum cupSize {
  SMALL
  MEDIUM
  LARGE
}

enum sweetness {
  NO_SUGAR
  LESS_SUGAR
  NORMAL_SUGAR
  MORE_SUGAR
}

enum stockStatus {
  OUT
  LOW
  OK
}
