// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum userRole {
  CUSTOMER
  EMPLOYEE
  MANAGER
}

enum statusOrder {
  PENDING
  COMPLETED
  CANCELLED
}

enum drinkType {
  HOT
  COLD
  MIXED
}

enum cupSize {
  SMALL
  MEDIUM
  LARGE
}

enum sweetness {
  NO_SUGAR
  LESS_SUGAR
  NORMAL_SUGAR
  MORE_SUGAR
}

enum stockStatus {
  OUT
  LOW
  OK
}

model User {
  id  String @id @default(cuid())
  name String?
  email     String   @unique
  password  String
  role      userRole @default(CUSTOMER)


  orders   Order[]
  restocks Restock[]
  
}

model Drink {
  id         Int        @id @default(autoincrement())
  name        String
  price       Float
  mainIngredient String?
  img String?


  orders Order[]
  ingredients Ingredient[]
}

model StockItem {
  id          Int        @id @default(autoincrement())
  name     String
  category String
  unit     String
  maxQuantity Int
  img String?

  currentQuantity    Int @default(0)
  status  stockStatus @default(OUT)
  lastUpdated DateTime @default(now())

  useIn Ingredient[]
  restock Restock[]
}

// relationships
model Order {
  id          Int        @id @default(autoincrement())
  addon     Int?
  drinkType   drinkType  @default(COLD)
  sweetLevel  sweetness  @default(NORMAL_SUGAR)
  cupSize     cupSize    @default(MEDIUM)
  orderStatus statusOrder @default(PENDING)
  orderDate   DateTime   @default(now())
  amount      Int        @default(1)

  employee   User?   @relation(fields: [employeeId], references: [id])
  employeeId String?
  drink      Drink  @relation(fields: [drinkId], references: [id])
  drinkId    Int
}

model Ingredient {
  id      Int      @id @default(autoincrement())
  quantity Float

  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  stockItemId Int
  drink Drink @relation(fields: [drinkId], references: [id], onDelete: Cascade)
  drinkId Int

}

model Restock {
  id  String @id  @default(uuid())
  oldQuantity Int
  newQuantity Int
  totalQuantity Int
  employeeId String

  restockDate DateTime @default(now())
  stockItemId Int
  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  employee User @relation(fields: [employeeId], references: [id])
}